NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DATABASE_URL=postgres://rankforge:rankforge_dev_password@localhost:5432/rankforge
DATABASE_SSL=false
SESSION_TTL_DAYS=7
COOKIE_DOMAIN=
# Set these only when real provider credentials and delivery endpoints are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
SMS_DELIVERY_URL=
SMS_DELIVERY_TOKEN=
# Development only: return email verification/reset tokens and SMS OTP in API responses.
# MUST be false in production.
AUTH_EXPOSE_DEV_CODES=true
# A long random secret used to sign OAuth state cookies (generate with: openssl rand -hex 32)
OAUTH_STATE_SECRET=replace-this-with-a-long-random-secret-before-deploying
